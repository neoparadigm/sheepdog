@prefix sh:       <http://www.w3.org/ns/shacl#> .
@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix prov:     <http://www.w3.org/ns/prov#> .
@prefix sheepdogai: <https://example.org/sheepdogai#> .
@prefix shp:      <https://example.org/sheepdogai/shapes#> .

# Every exported run graph must satisfy these shapes.

shp:Declare a sh:NodeShape ;
    sh:declare [ sh:prefix "sheepdogai" ; sh:namespace "https://example.org/sheepdogai#"^^xsd:anyURI ] ,
               [ sh:prefix "prov" ; sh:namespace "http://www.w3.org/ns/prov#"^^xsd:anyURI ] .

shp:RunShape a sh:NodeShape ;
    sh:targetClass sheepdogai:Run ;
    sh:property [ sh:path sheepdogai:policyHash ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .

shp:ToolCallShape a sh:NodeShape ;
    sh:targetClass sheepdogai:ToolCall ;
    sh:property [ sh:path prov:wasAssociatedWith ; sh:minCount 1 ; sh:class sheepdogai:Agent ] ;
    sh:property [ sh:path sheepdogai:governedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:class sheepdogai:Policy ] ;
    sh:property [ sh:path sheepdogai:matchedRule ; sh:maxCount 1 ; sh:class sheepdogai:Rule ] ;
    sh:property [ sh:path sheepdogai:approvedBy ; sh:maxCount 1 ; sh:class sheepdogai:HumanApproval ] ;
    sh:property [ sh:path [ sh:inversePath prov:wasGeneratedBy ] ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:class sheepdogai:Verdict ;
                  sh:message "every ToolCall has exactly one Verdict" ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes shp:Declare ;
        sh:message "an ask verdict needs a HumanApproval (approval, delegation or timeout deny)" ;
        sh:select """
            SELECT $this WHERE {
              ?v prov:wasGeneratedBy $this ; sheepdogai:verdictValue "ask" .
              FILTER NOT EXISTS { $this sheepdogai:approvedBy ?a }
            }""" ] .

shp:VerdictShape a sh:NodeShape ;
    sh:targetClass sheepdogai:Verdict ;
    sh:property [ sh:path sheepdogai:verdictValue ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ( "allow" "ask" "deny" ) ] ;
    sh:property [ sh:path sheepdogai:strictness ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:integer ; sh:in ( 0 1 2 ) ] ;
    sh:property [ sh:path sheepdogai:decidedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:class sheepdogai:Decider ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes shp:Declare ;
        sh:message "strictness does not match verdictValue" ;
        sh:select """
            SELECT $this WHERE {
              $this sheepdogai:verdictValue ?v ; sheepdogai:strictness ?s .
              FILTER NOT EXISTS { ?lvl sheepdogai:verdictValue ?v ; sheepdogai:strictness ?s . }
              FILTER (!( (?v = "allow" && ?s = 0) || (?v = "ask" && ?s = 1) || (?v = "deny" && ?s = 2) ))
            }""" ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes shp:Declare ;
        sh:message "Decider verdict is less strict than the rules verdict it received (a Decider may only tighten)" ;
        sh:select """
            SELECT $this ?prior WHERE {
              $this sheepdogai:priorVerdict ?prior ; sheepdogai:strictness ?s .
              ?prior sheepdogai:strictness ?p .
              FILTER (?s < ?p)
            }""" ] .

shp:HumanApprovalShape a sh:NodeShape ;
    sh:targetClass sheepdogai:HumanApproval ;
    sh:property [ sh:path sheepdogai:outcome ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ( "approved" "denied" "timeout_deny" "delegated" "allow_once" "allow_run" ) ] ;
    sh:property [ sh:path sheepdogai:channel ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path prov:wasAssociatedWith ; sh:minCount 1 ; sh:class prov:Person ] .

shp:RuleShape a sh:NodeShape ;
    sh:targetClass sheepdogai:Rule ;
    sh:property [ sh:path sheepdogai:ruleId ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path sheepdogai:memberOf ; sh:minCount 1 ; sh:class sheepdogai:Policy ] .

shp:PolicyShape a sh:NodeShape ;
    sh:targetClass sheepdogai:Policy ;
    sh:property [ sh:path sheepdogai:policyHash ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:pattern "^[0-9a-f]{64}$" ] .

shp:LogRecordShape a sh:NodeShape ;
    sh:targetClass sheepdogai:LogRecord ;
    sh:property [ sh:path sheepdogai:hash ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^[0-9a-f]{64}$" ] ;
    sh:property [ sh:path sheepdogai:prevHash ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^[0-9a-f]{64}$" ] .

shp:BudgetShape a sh:NodeShape ;
    sh:targetClass sheepdogai:Budget ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes shp:Declare ;
        sh:message "a Budget may only be linked (exceeded) to a deny verdict" ;
        sh:select """
            SELECT $this WHERE {
              $this sheepdogai:exceeded ?v .
              FILTER NOT EXISTS { ?v sheepdogai:verdictValue "deny" }
            }""" ] .
