{
  "@context": {
    "@version": 1.1,
    "prov": "http://www.w3.org/ns/prov#",
    "sheepdogai": "https://example.org/sheepdogai#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "id": "@id",
    "type": "@type",
    "label": "rdfs:label",
    "Run": "sheepdogai:Run",
    "ToolCall": "sheepdogai:ToolCall",
    "Agent": "sheepdogai:Agent",
    "Policy": "sheepdogai:Policy",
    "Rule": "sheepdogai:Rule",
    "Verdict": "sheepdogai:Verdict",
    "Decider": "sheepdogai:Decider",
    "HumanApproval": "sheepdogai:HumanApproval",
    "Budget": "sheepdogai:Budget",
    "Adapter": "sheepdogai:Adapter",
    "LogRecord": "sheepdogai:LogRecord",
    "governedBy": {"@id": "sheepdogai:governedBy", "@type": "@id"},
    "matchedRule": {"@id": "sheepdogai:matchedRule", "@type": "@id"},
    "decidedBy": {"@id": "sheepdogai:decidedBy", "@type": "@id"},
    "approvedBy": {"@id": "sheepdogai:approvedBy", "@type": "@id"},
    "exceeded": {"@id": "sheepdogai:exceeded", "@type": "@id"},
    "hasCapability": {"@id": "sheepdogai:hasCapability", "@type": "@id"},
    "priorVerdict": {"@id": "sheepdogai:priorVerdict", "@type": "@id"},
    "observedBy": {"@id": "sheepdogai:observedBy", "@type": "@id"},
    "follows": {"@id": "sheepdogai:follows", "@type": "@id"},
    "memberOf": {"@id": "sheepdogai:memberOf", "@type": "@id"},
    "partOf": {"@id": "sheepdogai:partOf", "@type": "@id"},
    "wasGeneratedBy": {"@id": "prov:wasGeneratedBy", "@type": "@id"},
    "wasAssociatedWith": {"@id": "prov:wasAssociatedWith", "@type": "@id"},
    "wasAttributedTo": {"@id": "prov:wasAttributedTo", "@type": "@id"},
    "startedAtTime": {"@id": "prov:startedAtTime", "@type": "xsd:dateTime"},
    "verdictValue": "sheepdogai:verdictValue",
    "strictness": {"@id": "sheepdogai:strictness", "@type": "xsd:integer"},
    "policyHash": "sheepdogai:policyHash",
    "hash": "sheepdogai:hash",
    "prevHash": "sheepdogai:prevHash",
    "reason": "sheepdogai:reason",
    "ruleId": "sheepdogai:ruleId",
    "outcome": "sheepdogai:outcome",
    "channel": "sheepdogai:channel",
    "seq": {"@id": "sheepdogai:seq", "@type": "xsd:integer"},
    "toolName": "sheepdogai:toolName",
    "toolKind": "sheepdogai:toolKind",
    "summary": "sheepdogai:summary",
    "untrustedContentSeen": {"@id": "sheepdogai:untrustedContentSeen", "@type": "xsd:boolean"},
    "name": "sheepdogai:name",
    "index": {"@id": "sheepdogai:index", "@type": "xsd:integer"}
  }
}
