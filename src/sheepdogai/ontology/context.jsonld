{
  "@context": {
    "@version": 1.1,
    "prov": "http://www.w3.org/ns/prov#",
    "sheepdog": "https://example.org/sheepdog#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "id": "@id",
    "type": "@type",
    "label": "rdfs:label",
    "Run": "sheepdog:Run",
    "ToolCall": "sheepdog:ToolCall",
    "Agent": "sheepdog:Agent",
    "Policy": "sheepdog:Policy",
    "Rule": "sheepdog:Rule",
    "Verdict": "sheepdog:Verdict",
    "Decider": "sheepdog:Decider",
    "HumanApproval": "sheepdog:HumanApproval",
    "Budget": "sheepdog:Budget",
    "Adapter": "sheepdog:Adapter",
    "LogRecord": "sheepdog:LogRecord",
    "governedBy": {"@id": "sheepdog:governedBy", "@type": "@id"},
    "matchedRule": {"@id": "sheepdog:matchedRule", "@type": "@id"},
    "decidedBy": {"@id": "sheepdog:decidedBy", "@type": "@id"},
    "approvedBy": {"@id": "sheepdog:approvedBy", "@type": "@id"},
    "exceeded": {"@id": "sheepdog:exceeded", "@type": "@id"},
    "hasCapability": {"@id": "sheepdog:hasCapability", "@type": "@id"},
    "priorVerdict": {"@id": "sheepdog:priorVerdict", "@type": "@id"},
    "observedBy": {"@id": "sheepdog:observedBy", "@type": "@id"},
    "follows": {"@id": "sheepdog:follows", "@type": "@id"},
    "memberOf": {"@id": "sheepdog:memberOf", "@type": "@id"},
    "partOf": {"@id": "sheepdog:partOf", "@type": "@id"},
    "wasGeneratedBy": {"@id": "prov:wasGeneratedBy", "@type": "@id"},
    "wasAssociatedWith": {"@id": "prov:wasAssociatedWith", "@type": "@id"},
    "wasAttributedTo": {"@id": "prov:wasAttributedTo", "@type": "@id"},
    "startedAtTime": {"@id": "prov:startedAtTime", "@type": "xsd:dateTime"},
    "verdictValue": "sheepdog:verdictValue",
    "strictness": {"@id": "sheepdog:strictness", "@type": "xsd:integer"},
    "policyHash": "sheepdog:policyHash",
    "hash": "sheepdog:hash",
    "prevHash": "sheepdog:prevHash",
    "reason": "sheepdog:reason",
    "ruleId": "sheepdog:ruleId",
    "outcome": "sheepdog:outcome",
    "channel": "sheepdog:channel",
    "seq": {"@id": "sheepdog:seq", "@type": "xsd:integer"},
    "toolName": "sheepdog:toolName",
    "toolKind": "sheepdog:toolKind",
    "summary": "sheepdog:summary",
    "untrustedContentSeen": {"@id": "sheepdog:untrustedContentSeen", "@type": "xsd:boolean"},
    "name": "sheepdog:name",
    "index": {"@id": "sheepdog:index", "@type": "xsd:integer"}
  }
}
