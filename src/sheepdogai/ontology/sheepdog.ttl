@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix prov:     <http://www.w3.org/ns/prov#> .
@prefix sheepdog: <https://example.org/sheepdog#> .

# Placeholder namespace (sheepdogai.constants.ONTOLOGY_NS). Replace with a stable URL.

<https://example.org/sheepdog> a owl:Ontology ;
    rdfs:label "Sheepdog vocabulary" ;
    rdfs:comment "Policy verdicts, approvals, budgets and adapter capabilities for agent tool calls. Reuses W3C PROV-O for provenance." ;
    owl:imports <http://www.w3.org/ns/prov-o#> .

# ---- classes -------------------------------------------------------------
sheepdog:Run           a owl:Class ; rdfs:subClassOf prov:Bundle ;        rdfs:label "Run" ;           rdfs:comment "One agent run; carries the policy hash." .
sheepdog:ToolCall      a owl:Class ; rdfs:subClassOf prov:Activity ;      rdfs:label "Tool call" ;     rdfs:comment "One normalised tool call. OTel: span with gen_ai.operation.name=execute_tool." .
sheepdog:Agent         a owl:Class ; rdfs:subClassOf prov:SoftwareAgent ; rdfs:label "Agent" ;         rdfs:comment "The agent under control." .
sheepdog:Policy        a owl:Class ; rdfs:subClassOf prov:Plan ;          rdfs:label "Policy" ;        rdfs:comment "A versioned rules file plus packs." .
sheepdog:Rule          a owl:Class ; rdfs:subClassOf prov:Entity ;        rdfs:label "Rule" ;          rdfs:comment "A rule, member of a policy." .
sheepdog:Verdict       a owl:Class ; rdfs:subClassOf prov:Entity ;        rdfs:label "Verdict" ;       rdfs:comment "allow, ask or deny for one tool call." .
sheepdog:Decider       a owl:Class ; rdfs:subClassOf prov:SoftwareAgent ; rdfs:label "Decider" ;       rdfs:comment "Rules engine, model or judge." .
sheepdog:HumanApproval a owl:Class ; rdfs:subClassOf prov:Activity ;      rdfs:label "Human approval" ; rdfs:comment "Present only when the verdict was ask; associated with a prov:Person." .
sheepdog:Budget        a owl:Class ; rdfs:subClassOf prov:Entity ;        rdfs:label "Budget" ;        rdfs:comment "A constraint on a run." .
sheepdog:Adapter       a owl:Class ; rdfs:subClassOf prov:SoftwareAgent ; rdfs:label "Adapter" ;       rdfs:comment "Carries declared capabilities." .
sheepdog:LogRecord     a owl:Class ; rdfs:subClassOf prov:Entity ;        rdfs:label "Log record" ;    rdfs:comment "Holds prev_hash and hash." .
sheepdog:Capability    a owl:Class ; rdfs:label "Adapter capability" .
sheepdog:StrictnessLevel a owl:Class ; rdfs:label "Strictness level" .

# ---- object properties ---------------------------------------------------
sheepdog:governedBy   a owl:ObjectProperty ; rdfs:domain sheepdog:ToolCall ; rdfs:range sheepdog:Policy .
sheepdog:matchedRule  a owl:ObjectProperty ; rdfs:domain sheepdog:ToolCall ; rdfs:range sheepdog:Rule .
sheepdog:decidedBy    a owl:ObjectProperty ; rdfs:domain sheepdog:Verdict  ; rdfs:range sheepdog:Decider .
sheepdog:approvedBy   a owl:ObjectProperty ; rdfs:domain sheepdog:ToolCall ; rdfs:range sheepdog:HumanApproval .
sheepdog:exceeded     a owl:ObjectProperty ; rdfs:domain sheepdog:Budget   ; rdfs:range sheepdog:Verdict ;
    rdfs:comment "Links a budget to the stopping verdict." .
sheepdog:hasCapability a owl:ObjectProperty ; rdfs:domain sheepdog:Adapter ; rdfs:range sheepdog:Capability .
sheepdog:priorVerdict a owl:ObjectProperty ; rdfs:domain sheepdog:Verdict ; rdfs:range sheepdog:Verdict ;
    rdfs:comment "The rules verdict that a Decider verdict received as input." .
sheepdog:observedBy   a owl:ObjectProperty ; rdfs:domain sheepdog:ToolCall ; rdfs:range sheepdog:Adapter .
sheepdog:follows      a owl:ObjectProperty ; rdfs:domain sheepdog:LogRecord ; rdfs:range sheepdog:LogRecord ;
    rdfs:comment "Hash-chain link to the previous record." .
sheepdog:memberOf     a owl:ObjectProperty ; rdfs:domain sheepdog:Rule ; rdfs:range sheepdog:Policy .
sheepdog:partOf       a owl:ObjectProperty ; rdfs:range sheepdog:Run ; rdfs:comment "Membership in a run bundle." .
sheepdog:stricterThan a owl:ObjectProperty , owl:TransitiveProperty ; rdfs:domain sheepdog:StrictnessLevel ; rdfs:range sheepdog:StrictnessLevel .

# ---- datatype properties -------------------------------------------------
sheepdog:verdictValue a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "One of allow, ask, deny." .
sheepdog:strictness   a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:comment "0 allow, 1 ask, 2 deny." .
sheepdog:policyHash   a owl:DatatypeProperty ; rdfs:range xsd:string .
sheepdog:hash         a owl:DatatypeProperty ; rdfs:range xsd:string .
sheepdog:prevHash     a owl:DatatypeProperty ; rdfs:range xsd:string .
sheepdog:reason       a owl:DatatypeProperty ; rdfs:range xsd:string .
sheepdog:ruleId       a owl:DatatypeProperty ; rdfs:range xsd:string .
sheepdog:outcome      a owl:DatatypeProperty ; rdfs:range xsd:string .
sheepdog:channel      a owl:DatatypeProperty ; rdfs:range xsd:string .
sheepdog:seq          a owl:DatatypeProperty ; rdfs:range xsd:integer .
sheepdog:toolName     a owl:DatatypeProperty ; rdfs:range xsd:string .
sheepdog:toolKind     a owl:DatatypeProperty ; rdfs:range xsd:string .
sheepdog:summary      a owl:DatatypeProperty ; rdfs:range xsd:string .
sheepdog:untrustedContentSeen a owl:DatatypeProperty ; rdfs:range xsd:boolean .
sheepdog:name         a owl:DatatypeProperty ; rdfs:range xsd:string .
sheepdog:index        a owl:DatatypeProperty ; rdfs:range xsd:integer .

# ---- ordered individuals: Deny is stricter than Ask is stricter than Allow ---
sheepdog:Allow a sheepdog:StrictnessLevel ; sheepdog:verdictValue "allow" ; sheepdog:strictness 0 .
sheepdog:Ask   a sheepdog:StrictnessLevel ; sheepdog:verdictValue "ask"   ; sheepdog:strictness 1 ;
    sheepdog:stricterThan sheepdog:Allow .
sheepdog:Deny  a sheepdog:StrictnessLevel ; sheepdog:verdictValue "deny"  ; sheepdog:strictness 2 ;
    sheepdog:stricterThan sheepdog:Ask , sheepdog:Allow .

# ---- adapter capability individuals ---------------------------------------
sheepdog:CanBlock        a sheepdog:Capability ; rdfs:label "can_block" .
sheepdog:CanAsk          a sheepdog:Capability ; rdfs:label "can_ask" .
sheepdog:SeesMcp         a sheepdog:Capability ; rdfs:label "sees_mcp" .
sheepdog:SeesFileEdits   a sheepdog:Capability ; rdfs:label "sees_file_edits" .
